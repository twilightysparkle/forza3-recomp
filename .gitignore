# Game data - never commit. Players use their own copy.
/assets/*
!/assets/README.md
/game/
*.iso
*.xex

# Build output, packages, downloaded and built SDK
/out/
/dist/
/_sdk/

# Per-player and per-run files
/userdata/
forza3.user.toml
forza3.launcher.ini

# Box art: copyrighted, kept local (the launcher reads it at runtime)
cover.png
/run/
/run*.log
logs/
crashdumps/
pixcaptures/
*.dmp

# Local analysis output
__pycache__/
/codegen_run*
/build_run*

# Codegen dependency file: absolute local paths, regenerated by each build
/generated/default/codegen.d
